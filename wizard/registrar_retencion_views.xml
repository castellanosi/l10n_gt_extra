<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ REGISTRAR RETENCIÓN COMO PAGO (5.62) ============ -->
    <record id="registrar_retencion_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_gt_extra.registrar_retencion.wizard</field>
        <field name="model">l10n_gt_extra.registrar_retencion.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrar retención">
                <div class="alert alert-info mb-2" role="status">
                    La retención se registra como un <b>pago parcial</b> de la factura: baja el
                    saldo del cliente o proveedor y sale como pago en el estado de cuenta.
                    La factura y su DTE no cambian.
                </div>
                <div class="alert alert-warning mb-2" role="alert" invisible="not aviso">
                    <field name="aviso" readonly="1"/>
                </div>
                <group>
                    <group string="Factura">
                        <field name="move_id"/>
                        <field name="partner_id"/>
                        <field name="total_factura"/>
                        <field name="saldo_pendiente"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                        <field name="es_venta" invisible="1"/>
                    </group>
                    <group string="Retención">
                        <field name="journal_id" options="{'no_create': True, 'no_open': True}" required="1"/>
                        <field name="cuenta_id" readonly="1"/>
                        <field name="payment_method_line_id" invisible="1"/>
                        <field name="monto" required="1"/>
                        <field name="fecha"/>
                        <field name="numero_constancia" placeholder="Número de la constancia de retención"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirmar" string="Registrar retención" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
