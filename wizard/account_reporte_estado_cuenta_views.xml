<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="reporte_estado_cuenta_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_gt_extra.reporte_estado_cuenta.wizard</field>
        <field name="model">l10n_gt_extra.reporte_estado_cuenta.wizard</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Estado de Cuenta por Cliente / Proveedor">
                <group>
                    <group>
                        <field name="partner_id"/>
                        <field name="fecha_desde"/>
                        <field name="fecha_hasta"/>
                    </group>
                    <group>
                        <field name="name" invisible="1"/>
                        <field name="archivo" readonly="1" filename="name"/>
                    </group>
                </group>
                <footer>
                    <button name="print_report" string="Reporte PDF" type="object" class="oe_highlight"/>
                    <button name="print_report_excel" string="Reporte Excel" type="object" class="oe_highlight"/>
                    <button special="cancel" string="Cancelar" class="oe_link"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="reporte_estado_cuenta_wizard_action" model="ir.actions.act_window">
        <field name="name">Estado de Cuenta</field>
        <field name="res_model">l10n_gt_extra.reporte_estado_cuenta.wizard</field>
        <field name="view_mode">form</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="target">new</field>
    </record>

    <record id="reporte_estado_cuenta_wizard_report" model="ir.actions.report">
        <field name="name">l10n_gt_extra.reporte_estado_cuenta</field>
        <field name="model">l10n_gt_extra.reporte_estado_cuenta.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_gt_extra.reporte_estado_cuenta</field>
        <field name="report_file">l10n_gt_extra.reporte_estado_cuenta</field>
    </record>

    <menuitem id="reporte_estado_cuenta_wizard_menu"
              action="reporte_estado_cuenta_wizard_action"
              parent="menu_informes"/>

</odoo>
