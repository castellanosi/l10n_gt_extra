                        <field name="solo_con_saldo"/>
                    </group>
                    <group>
                        <field name="name" invisible="1"/>
                        <field name="archivo" readonly="1" filename="name"/>
                    </group>
                </group>
                <footer>
                    <button name="preview_report" string="&#x1F441; Previsualizar" type="object" class="btn-secondary"/>

                    <button name="print_report" string="Reporte PDF" type="object" class="oe_highlight"/>
                    <button name="print_report_excel" string="Reporte Excel" type="object" class="oe_highlight"/>
                    <button special="cancel" string="Cancelar" class="oe_link"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="reporte_cuentas_pagar_wizard_action" model="ir.actions.act_window">
        <field name="name">Cuentas por Pagar</field>
        <field name="res_model">l10n_gt_extra.reporte_cuentas_pagar.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="reporte_cuentas_pagar_wizard_report" model="ir.actions.report">
        <field name="name">l10n_gt_extra.reporte_cuentas_pagar</field>
        <field name="model">l10n_gt_extra.reporte_cuentas_pagar.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_gt_extra.reporte_cuentas_pagar</field>
        <field name="report_file">l10n_gt_extra.reporte_cuentas_pagar</field>
    </record>

    <menuitem id="reporte_cuentas_pagar_wizard_menu"
              action="reporte_cuentas_pagar_wizard_action"
              parent="menu_informes"/>

</odoo>
