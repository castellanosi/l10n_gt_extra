        <field name="name">l10n_gt_extra.reporte_cuentas_pagar.wizard</field>
        <field name="model">l10n_gt_extra.reporte_cuentas_pagar.wizard</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
