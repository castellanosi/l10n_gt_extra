<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="reporte_fel_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_gt_extra.reporte_fel.wizard</field>
        <field name="model">l10n_gt_extra.reporte_fel.wizard</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Reporte Facturas Electrónicas FEL">
                <group>
                    <group>
                        <field name="folio_inicial"/>
                    <field name="tipo"/>
                        <field name="fecha_desde"/>
                        <field name="fecha_hasta"/>
                        <field name="solo_fel"/>
                    </group>
                    <group>
                        <field name="diarios_id" widget="many2many_tags"/>
                        <field name="name" invisible="1"/>
                        <field name="archivo" readonly="1" filename="name"/>
                    </group>
                </group>
                <footer>
                    <button name="preview_report" string="&#x1F441; Previsualizar" type="object" class="btn-secondary"/>

                    <button name="print_report" string="Reporte PDF" type="object" class="oe_highlight"/>
                    <button name="print_report_excel" string="Reporte Excel" type="object" class="oe_highlight"/>
                    <button special="cancel" string="Cancelar" class="oe_link"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="reporte_fel_wizard_action" model="ir.actions.act_window">
        <field name="name">Facturas Electrónicas FEL</field>
        <field name="res_model">l10n_gt_extra.reporte_fel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="reporte_fel_wizard_report" model="ir.actions.report">
        <field name="name">l10n_gt_extra.reporte_fel</field>
        <field name="model">l10n_gt_extra.reporte_fel.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_gt_extra.reporte_fel</field>
        <field name="report_file">l10n_gt_extra.reporte_fel</field>
    </record>

    <menuitem id="reporte_fel_wizard_menu"
              action="reporte_fel_wizard_action"
              parent="menu_informes"/>

</odoo>
