<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================== CUENTAS POR COBRAR ===================== -->
    <template id="reporte_cuentas_cobrar">
        <t t-call="web.html_container">
            <t t-set="data_report_margin_top" t-value="40"/>
            <t t-set="data_report_header_spacing" t-value="34"/>
            <t t-call="l10n_gt_extra.encabezado_folio">
                <t t-set="titulo" t-value="'Reporte de Cuentas por Cobrar'"/>
            </t>
            <t t-call="l10n_gt_extra.cuerpo_reporte">
                <div class="page">
                    <div style="font-size: 12px; margin-bottom: 8px;">
                        <strong>Saldo al corte del:</strong>
                        <span t-esc="data['fecha_corte']" t-options="{'widget': 'date'}"/>
                        <t t-if="data.get('fecha_inicio')"> — solo documentos del período</t>
                        <t t-if="data.get('solo_con_saldo')"> — solo clientes con saldo pendiente</t></div>

                    <t t-set="result" t-value="lineas(data)"/>

                    <table class="table table-condensed" style="font-size:10px;">
                        <thead>
                            <tr style="background:#ede9f7;">
                                <th>Cliente</th>
                                <th>NIT</th>
                                <th class="text-right text-end">0-30 días</th>
                                <th class="text-right text-end">31-60 días</th>
                                <th class="text-right text-end">61-90 días</th>
                                <th class="text-right text-end">+90 días</th>
                                <th class="text-right text-end">Saldo Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="result['lineas']" t-as="l">
                                <td><span t-esc="l['nombre']"/></td>
                                <td><span t-esc="l['nit']"/></td>
                                <td class="text-right text-end">
                                    <span t-if="l['d30']" t-esc="l['d30']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-right text-end">
                                    <span t-if="l['d60']" t-esc="l['d60']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-right text-end">
                                    <span t-if="l['d90']" t-esc="l['d90']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-right text-end" style="color:#c0392b;">
                                    <span t-if="l['d90mas']" t-esc="l['d90mas']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-right text-end" style="font-weight:500;">
                                    <span t-esc="l['saldo']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr style="background:#e8e4f5; font-weight:bold;">
                                <td>Totales (<span t-esc="result['totales']['num_clientes']"/> clientes)</td>
                                <td></td>
                                <td class="text-right text-end">
                                    <span t-esc="result['totales']['d30']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-right text-end">
                                    <span t-esc="result['totales']['d60']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-right text-end">
                                    <span t-esc="result['totales']['d90']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-right text-end">
                                    <span t-esc="result['totales']['d90mas']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-right text-end">
                                    <span t-esc="result['totales']['saldo']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>

