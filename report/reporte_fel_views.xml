<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="reporte_fel">
        <t t-call="web.html_container">
            <t t-set="data_report_margin_top" t-value="30"/>
            <t t-set="data_report_header_spacing" t-value="20"/>
            <t t-call="web.external_layout">
                <div class="page">
                    <h2><span t-field="current_company_id.name"/>: Reporte Facturas Electrónicas (FEL)</h2>

                    <div class="row my-2">
                        <div class="col-6">
                            <strong>NIT:</strong> <span t-field="current_company_id.vat"/><br/>
                            <strong>Tipo:</strong>
                            <span t-esc="'Compras' if data.get('tipo') == 'compra' else 'Ventas'"/>
                        </div>
                        <div class="col-6">
                            <strong>Período del:</strong>
                            <span t-esc="data['fecha_desde']" t-options="{'widget': 'date'}"/>
                            al <span t-esc="data['fecha_hasta']" t-options="{'widget': 'date'}"/>
                        </div>
                    </div>

                    <t t-set="result" t-value="lineas(data)"/>

                    <table class="table table-condensed" style="font-size:10px;">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Tipo</th>
                                <th>Serie</th>
                                <th>No.</th>
                                <th>UUID / Autorización</th>
                                <th>Proveedor / Cliente</th>
                                <th>NIT</th>
                                <th class="text-right text-end">Base</th>
                                <th class="text-right text-end">IVA</th>
                                <th class="text-right text-end">ISR/Ret.</th>
                                <th class="text-right text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="result['lineas']" t-as="l">
                                <td><span t-esc="l['fecha']" t-options="{'widget': 'date'}"/></td>
                                <td><span t-esc="l['tipo']"/></td>
                                <td><span t-esc="l['serie']"/></td>
                                <td><span t-esc="l['numero']"/></td>
                                <td style="font-size:8px;"><span t-esc="l['uuid']"/></td>
                                <td><span t-esc="l['partner']"/></td>
                                <td><span t-esc="l['nit']"/></td>
                                <td class="text-right text-end">
                                    <span t-esc="l['base']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-right text-end">
                                    <span t-esc="l['iva']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-right text-end">
                                    <span t-esc="l['isr']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-right text-end">
                                    <span t-esc="l['total']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="7">
                                    <strong>Totales (<span t-esc="result['totales']['num_facturas']"/> facturas)</strong>
                                </td>
                                <td class="text-right text-end">
                                    <strong><span t-esc="result['totales']['base']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong>
                                </td>
                                <td class="text-right text-end">
                                    <strong><span t-esc="result['totales']['iva']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong>
                                </td>
                                <td class="text-right text-end">
                                    <strong><span t-esc="result['totales']['isr']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong>
                                </td>
                                <td class="text-right text-end">
                                    <strong><span t-esc="result['totales']['total']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
