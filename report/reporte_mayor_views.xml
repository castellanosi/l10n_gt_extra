<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="reporte_mayor">
        <t t-call="web.html_container">
            <t t-set="data_report_margin_top" t-value="40"/>
            <t t-set="data_report_header_spacing" t-value="34"/>
            <t t-call="l10n_gt_extra.encabezado_folio">
                <t t-set="titulo" t-value="'Libro Mayor' + {'resumido': ' — Resumido', 'por_dia': ' — Agrupado por día', 'detallado': ' — Detallado'}.get(data.get('modo'), '')"/>
            </t>
            <t t-call="l10n_gt_extra.cuerpo_reporte">
                <div class="page">

                    <t t-set="result" t-value="lineas(data)"/>

                    <t t-if="data.get('modo') == 'detallado'">
                        <table class="table table-condensed">
                            <thead>
                                <tr>
                                    <th style="width: 10%;">Fecha</th>
                                    <th style="width: 15%;">Asiento / Doc.</th>
                                    <th>Tercero / Etiqueta</th>
                                    <th class="text-right text-end" style="width: 12%;">Debe</th>
                                    <th class="text-right text-end" style="width: 12%;">Haber</th>
                                    <th class="text-right text-end" style="width: 13%;">Saldo</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="result['lineas']" t-as="c">
                                    <tr style="background: #f2f2f2;">
                                        <td colspan="5">
                                            <strong t-esc="c['codigo']"/> &#160; <strong t-esc="c['cuenta']"/>
                                            &#160;&#160;— Saldo inicial
                                        </td>
                                        <td class="text-right text-end"><strong t-esc="c['saldo_inicial']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                    </tr>
                                    <tr t-foreach="c['movimientos']" t-as="l">
                                        <td><span t-esc="l['fecha']" t-options="{'widget': 'date'}"/></td>
                                        <td>
                                            <span t-esc="l['asiento']"/>
                                            <t t-if="l['documento']"><br/><span t-esc="l['documento']"/></t>
                                        </td>
                                        <td>
                                            <span t-esc="l['tercero']"/>
                                            <t t-if="l['tercero'] and l['etiqueta']"> · </t>
                                            <span t-esc="l['etiqueta']"/>
                                        </td>
                                        <td class="text-right text-end"><span t-esc="l['debe']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                        <td class="text-right text-end"><span t-esc="l['haber']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                        <td class="text-right text-end"><span t-esc="l['saldo']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                    </tr>
                                    <tr>
                                        <td colspan="3" class="text-right text-end"><strong>Totales y saldo final <span t-esc="c['codigo']"/></strong></td>
                                        <td class="text-right text-end"><strong t-esc="c['total_debe']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                        <td class="text-right text-end"><strong t-esc="c['total_haber']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                        <td class="text-right text-end"><strong t-esc="c['saldo_final']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3">Totales</td>
                                    <td class="text-right text-end"><span t-esc="result['totales']['debe']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                    <td class="text-right text-end"><span t-esc="result['totales']['haber']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </t>
                    <t t-else="">
                    <table class="table table-condensed">
                        <t t-if="data['agrupado_por_dia'] == true">
                            <thead>
                                <tr>
                                    <th>Codigo</th>
                                    <th>Cuenta</th>
                                    <th>Fecha</th>
                                    <th class="text-right text-end">Saldo Inicial</th>
                                    <th class="text-right text-end">Debe</th>
                                    <th class="text-right text-end">Haber</th>
                                    <th class="text-right text-end">Saldo Final</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="result['lineas']" t-as="l">
                                    <tr>
                                        <td>
                                            <span t-esc="l['codigo']"/>
                                        </td>
                                        <td>
                                            <span t-esc="l['cuenta']"/>
                                        </td>
                                        <td>
                                        </td>
                                        <td class="text-right text-end">
                                            <span t-esc="l['saldo_inicial']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                        </td>
                                        <td class="text-right text-end">
                                            <span t-esc="l['total_debe']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                        </td>
                                        <td class="text-right text-end">
                                            <span t-esc="l['total_haber']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                        </td>
                                        <td class="text-right text-end">
                                            <span t-esc="l['saldo_final']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                        </td>
                                    </tr>
                                    <t t-foreach="l['fechas']" t-as="fecha">
                                        <tr>
                                            <td></td>
                                            <td></td>
                                            <td><span t-esc="fecha['fecha']" t-options='{"widget": "date"}'/></td>
                                            <td></td>
                                            <td class="text-right text-end"><span t-esc="fecha['debe']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                            <td class="text-right text-end"><span t-esc="fecha['haber']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                            <td></td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </t>
                        <t t-else="">
                            <thead>
                                <tr>
                                    <th>Codigo</th>
                                    <th>Cuenta</th>
                                    <th class="text-right text-end">Saldo Inicial</th>
                                    <th class="text-right text-end">Debe</th>
                                    <th class="text-right text-end">Haber</th>
                                    <th class="text-right text-end">Saldo Final</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="result['lineas']" t-as="l">
                                    <td>
                                        <span t-esc="l['codigo']"/>
                                    </td>
                                    <td>
                                        <span t-esc="l['cuenta']"/>
                                    </td>
                                    <td class="text-right text-end">
                                        <span t-esc="l['saldo_inicial']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                    </td>
                                    <td class="text-right text-end">
                                        <span t-esc="l['debe']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                    </td>
                                    <td class="text-right text-end">
                                        <span t-esc="l['haber']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                    </td>
                                    <td class="text-right text-end">
                                        <span t-esc="l['saldo_final']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                    </td>
                                    <td>
                                        <b>Totales</b>
                                    </td>
                                    <td>
                                    </td>
                                    <td class="text-right text-end">
                                        <b><span t-esc="result['totales']['debe']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></b>
                                    </td>
                                    <td class="text-right text-end">
                                        <b><span t-esc="result['totales']['haber']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></b>
                                    </td>
                                    <td class="text-right text-end">
                                    </td>
                                </tr>
                            </tbody>
                        </t>
                    </table>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
