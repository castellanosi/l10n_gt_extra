<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================== ESTADO DE RESULTADOS ===================== -->
    <template id="reporte_estado_resultados">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="row mb-2 mt-2">
                        <div class="col-12">
                            <h4 style="margin:0; border-bottom:1px solid #ccc; padding-bottom:4px;">
                                Estado de Resultados
                            </h4>
                        </div>
                    </div>
                    <div class="row mb-3" style="font-size:12px;">
                        <div class="col-6">
                            <strong>NIT:</strong> <span t-field="current_company_id.vat"/><br/>
                            <strong>Empresa:</strong> <span t-field="current_company_id.partner_id.name"/>
                        </div>
                        <div class="col-6">
                            <strong>Período del:</strong>
                            <span t-esc="data['fecha_desde']" t-options="{'widget': 'date'}"/>
                            al <span t-esc="data['fecha_hasta']" t-options="{'widget': 'date'}"/>
                        </div>
                    </div>
                    <t t-set="res" t-value="datos(data)"/>
                    <table class="table table-condensed mb-0" style="font-size:11px;">
                        <thead><tr style="background:#ede9f7;"><th colspan="2"><strong>Ingresos</strong></th></tr></thead>
                        <tbody>
                            <tr t-foreach="res['ingresos']" t-as="l">
                                <td><span t-esc="l['codigo']"/><t t-if="l['codigo']"> — </t><span t-esc="l['nombre']"/></td>
                                <td class="text-right text-end"><span t-esc="l['saldo']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                            </tr>
                        </tbody>
                        <tfoot><tr><td><strong>Total ingresos</strong></td><td class="text-right text-end"><strong><span t-esc="res['total_ingresos']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong></td></tr></tfoot>
                    </table>
                    <table class="table table-condensed mb-0 mt-1" style="font-size:11px;">
                        <thead><tr style="background:#fef3cd;"><th colspan="2"><strong>Costo de ventas</strong></th></tr></thead>
                        <tbody>
                            <tr t-foreach="res['costos']" t-as="l">
                                <td><span t-esc="l['codigo']"/><t t-if="l['codigo']"> — </t><span t-esc="l['nombre']"/></td>
                                <td class="text-right text-end"><span t-esc="l['saldo']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                            </tr>
                        </tbody>
                        <tfoot><tr><td><strong>Total costo de ventas</strong></td><td class="text-right text-end"><strong><span t-esc="res['total_costos']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong></td></tr></tfoot>
                    </table>
                    <table class="table table-condensed mb-0 mt-0" style="font-size:11px;">
                        <tbody><tr style="background:#d1e7dd;"><td><strong>Utilidad bruta</strong></td><td class="text-right text-end"><strong><span t-esc="res['utilidad_bruta']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong></td></tr></tbody>
                    </table>
                    <table class="table table-condensed mb-0 mt-1" style="font-size:11px;">
                        <thead><tr style="background:#f8d7da;"><th colspan="2"><strong>Gastos de operación</strong></th></tr></thead>
                        <tbody>
                            <tr t-foreach="res['gastos']" t-as="l">
                                <td><span t-esc="l['codigo']"/><t t-if="l['codigo']"> — </t><span t-esc="l['nombre']"/></td>
                                <td class="text-right text-end"><span t-esc="l['saldo']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                            </tr>
                        </tbody>
                        <tfoot><tr><td><strong>Total gastos de operación</strong></td><td class="text-right text-end"><strong><span t-esc="res['total_gastos']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong></td></tr></tfoot>
                    </table>
                    <table class="table table-condensed mt-1" style="font-size:11px;">
                        <tbody>
                            <tr style="background:#e2e3e5;">
                                <td><strong t-if="res['utilidad_neta'] >= 0">Utilidad neta del período</strong><strong t-else="">Pérdida neta del período</strong></td>
                                <td class="text-right text-end"><strong><span t-esc="res['utilidad_neta']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong></td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="row mt-4">
                        <div class="col-4 text-center"><br/><br/><div style="border-top:1px solid black; padding-top:4px; font-size:11px;">Preparado por</div></div>
                        <div class="col-4 text-center"><br/><br/><div style="border-top:1px solid black; padding-top:4px; font-size:11px;">Contador</div></div>
                        <div class="col-4 text-center"><br/><br/><div style="border-top:1px solid black; padding-top:4px; font-size:11px;">Gerente General</div></div>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <!-- ===================== BALANCE GENERAL ===================== -->
    <template id="reporte_balance_general">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="row mb-2 mt-2">
                        <div class="col-12">
                            <h4 style="margin:0; border-bottom:1px solid #ccc; padding-bottom:4px;">
                                Balance General
                            </h4>
                        </div>
                    </div>
                    <div class="row mb-3" style="font-size:12px;">
                        <div class="col-6">
                            <strong>NIT:</strong> <span t-field="current_company_id.vat"/><br/>
                            <strong>Empresa:</strong> <span t-field="current_company_id.partner_id.name"/>
                        </div>
                        <div class="col-6">
                            <strong>Al:</strong>
                            <span t-esc="data['fecha_hasta']" t-options="{'widget': 'date'}"/>
                        </div>
                    </div>
                    <t t-set="res" t-value="datos(data)"/>
                    <div class="row">
                        <div class="col-6">
                            <table class="table table-condensed" style="font-size:11px;">
                                <thead><tr style="background:#dae4f7;"><th colspan="2"><strong>Activos</strong></th></tr></thead>
                                <tbody>
                                    <tr t-foreach="res['activos']" t-as="l">
                                        <td><span t-esc="l['codigo']"/><t t-if="l['codigo']"> — </t><span t-esc="l['nombre']"/></td>
                                        <td class="text-right text-end"><span t-esc="l['saldo']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                    </tr>
                                </tbody>
                                <tfoot><tr style="background:#e2e3e5;"><td><strong>Total activos</strong></td><td class="text-right text-end"><strong><span t-esc="res['total_activo']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong></td></tr></tfoot>
                            </table>
                        </div>
                        <div class="col-6">
                            <table class="table table-condensed" style="font-size:11px;">
                                <thead><tr style="background:#fef3cd;"><th colspan="2"><strong>Pasivos</strong></th></tr></thead>
                                <tbody>
                                    <tr t-foreach="res['pasivos']" t-as="l">
                                        <td><span t-esc="l['codigo']"/><t t-if="l['codigo']"> — </t><span t-esc="l['nombre']"/></td>
                                        <td class="text-right text-end"><span t-esc="l['saldo']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                    </tr>
                                </tbody>
                                <tfoot><tr><td><strong>Total pasivos</strong></td><td class="text-right text-end"><strong><span t-esc="res['total_pasivo']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong></td></tr></tfoot>
                            </table>
                            <table class="table table-condensed mt-1" style="font-size:11px;">
                                <thead><tr style="background:#d1e7dd;"><th colspan="2"><strong>Capital contable</strong></th></tr></thead>
                                <tbody>
                                    <tr t-foreach="res['capital']" t-as="l">
                                        <td><span t-esc="l['codigo']"/><t t-if="l['codigo']"> — </t><span t-esc="l['nombre']"/></td>
                                        <td class="text-right text-end"><span t-esc="l['saldo']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                    </tr>
                                    <tr>
                                        <td><t t-if="res['utilidad_periodo'] >= 0">Utilidad del período</t><t t-else="">Pérdida del período</t></td>
                                        <td class="text-right text-end"><span t-esc="res['utilidad_periodo']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr><td><strong>Total capital</strong></td><td class="text-right text-end"><strong><span t-esc="res['total_capital_mas_utilidad']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong></td></tr>
                                    <tr style="background:#e2e3e5;"><td><strong>Total pasivos + capital</strong></td><td class="text-right text-end"><strong><span t-esc="res['total_pasivo_capital']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong></td></tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                    <t t-if="abs(res['cuadre']) &gt; 0.01">
                        <div style="background:#f8d7da; padding:6px; border-radius:4px; font-size:11px; margin-top:6px;">
                            <strong>Diferencia de cuadre:</strong>
                            <span t-esc="res['cuadre']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                        </div>
                    </t>
                    <div class="row mt-4">
                        <div class="col-4 text-center"><br/><br/><div style="border-top:1px solid black; padding-top:4px; font-size:11px;">Preparado por</div></div>
                        <div class="col-4 text-center"><br/><br/><div style="border-top:1px solid black; padding-top:4px; font-size:11px;">Contador</div></div>
                        <div class="col-4 text-center"><br/><br/><div style="border-top:1px solid black; padding-top:4px; font-size:11px;">Gerente General</div></div>
                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>
