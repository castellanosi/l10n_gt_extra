<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ CUERPO COMÚN: ESTADO DE RESULTADOS Y BALANCE ============ -->
    <!-- Una sola tabla para Resumen y Detalle: las columnas quedan alineadas
         sin anchos fijos. Espera `res` (de er_columnas / bg_columnas). -->
    <template id="cuerpo_financiero">
        <t t-set="cols" t-value="res['columnas']"/>
        <t t-set="ing" t-value="res['ingresos_col']"/>
        <t t-set="ncol" t-value="2 + len(res['encabezados'])"/>
        <t t-set="tam" t-value="'8px' if len(res['encabezados']) &gt; 7 else ('10px' if len(res['encabezados']) &gt; 1 else '11px')"/>
        <div style="font-size: 11px; margin-bottom: 6px;">
            Expresado en <span t-esc="current_company_id.currency_id.currency_unit_label or current_company_id.currency_id.name"/>
        </div>
        <table class="table table-condensed" t-attf-style="font-size: {{tam}};">
            <thead>
                <tr style="background:#ede9f7;">
                    <th class="l10n_gt_nowrap">Cuenta</th>
                    <th></th>
                    <th t-foreach="res['encabezados']" t-as="h" class="text-right text-end l10n_gt_nowrap"><span t-esc="h"/></th>
                </tr>
            </thead>
            <tbody>
                <tr style="background:#f4f2fb; font-weight: bold;">
                    <td t-att-colspan="ncol">RESUMEN</td>
                </tr>
                <tr t-foreach="res['resumen']" t-as="r" t-att-style="'font-weight: bold;' if r['negrita'] else None">
                    <td colspan="2"><span t-esc="r['etiqueta']"/></td>
                    <td t-foreach="celdas(r['valores'], cols, ing)" t-as="c" class="text-right text-end l10n_gt_nowrap"><span t-esc="formato(c['v'], c['pct'])"/></td>
                </tr>
                <tr><td t-att-colspan="ncol" style="border: none;">&#160;</td></tr>
                <t t-foreach="res['secciones']" t-as="sec">
                    <t t-if="sec['filas']">
                        <tr style="background:#f4f2fb; font-weight: bold;">
                            <td t-att-colspan="ncol"><span t-esc="sec['titulo']"/></td>
                        </tr>
                        <tr t-foreach="sec['filas']" t-as="f">
                            <td class="l10n_gt_nowrap"><span t-esc="f['codigo']"/></td>
                            <td><span t-esc="f['nombre']"/></td>
                            <td t-foreach="celdas(f['valores'], cols, ing)" t-as="c" class="text-right text-end l10n_gt_nowrap"><span t-esc="formato(c['v'], c['pct'])"/></td>
                        </tr>
                        <tr style="font-weight: bold; border-top: 1px solid #000;">
                            <td colspan="2">Total <span t-esc="sec['titulo'].lower()"/></td>
                            <td t-foreach="celdas(sec['total'], cols, ing)" t-as="c" class="text-right text-end l10n_gt_nowrap"><span t-esc="formato(c['v'], c['pct'])"/></td>
                        </tr>
                    </t>
                </t>
            </tbody>
        </table>
        <div class="row mt-4">
            <div class="col-4 text-center"><br/><br/><div style="border-top:1px solid black; padding-top:4px; font-size:11px;">Preparado por</div></div>
            <div class="col-4 text-center"><br/><br/><div style="border-top:1px solid black; padding-top:4px; font-size:11px;">Contador</div></div>
            <div class="col-4 text-center"><br/><br/><div style="border-top:1px solid black; padding-top:4px; font-size:11px;">Gerente General</div></div>
        </div>
    </template>

    <!-- ===================== ESTADO DE RESULTADOS ===================== -->
    <template id="reporte_estado_resultados">
        <t t-call="web.html_container">
            <t t-set="data_report_margin_top" t-value="40"/>
            <t t-set="data_report_header_spacing" t-value="34"/>
            <t t-call="l10n_gt_extra.encabezado_folio">
                <t t-set="titulo" t-value="'Estado de Resultados'"/>
            </t>
            <t t-call="l10n_gt_extra.cuerpo_reporte">
                <div class="page">
                    <t t-set="res" t-value="datos(data)"/>
                    <t t-call="l10n_gt_extra.cuerpo_financiero"/>
                </div>
            </t>
        </t>
    </template>

    <!-- ===================== BALANCE GENERAL ===================== -->
    <template id="reporte_balance_general">
        <t t-call="web.html_container">
            <t t-set="data_report_margin_top" t-value="40"/>
            <t t-set="data_report_header_spacing" t-value="34"/>
            <t t-call="l10n_gt_extra.encabezado_folio">
                <t t-set="titulo" t-value="'Balance General'"/>
            </t>
            <t t-call="l10n_gt_extra.cuerpo_reporte">
                <div class="page">
                    <t t-set="res" t-value="datos(data)"/>
                    <t t-call="l10n_gt_extra.cuerpo_financiero"/>
                </div>
            </t>
        </t>
    </template>

</odoo>
