<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="reporte_estado_cuenta">
        <t t-call="web.html_container">
            <t t-set="data_report_page_offset" t-value="data.get('folio_inicial', 1) + 1"/>
            <t t-set="data_report_margin_top" t-value="30"/>
            <t t-set="data_report_header_spacing" t-value="20"/>
            <div class="header">
                Folio: <span class="page" t-esc="data.get('folio_inicial', 1) - 1"/>
            </div>
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="row mb-2 mt-2">
                        <div class="col-12">
                            <h4 style="margin:0; border-bottom:1px solid #ccc; padding-bottom:4px;">
                                Estado de Cuenta
                            </h4>
                        </div>
                    </div>
                    <div class="row mb-3" style="font-size:12px;">
                        <div class="col-6">
                            <strong>Cliente / Proveedor:</strong> <span t-esc="data['partner_id'][1]"/><br/>
                            <strong>NIT:</strong> <span t-esc="partner.vat or 'CF'"/>
                        </div>
                        <div class="col-6">
                            <strong>Período del:</strong>
                            <span t-esc="data['fecha_desde']" t-options="{'widget': 'date'}"/>
                            al <span t-esc="data['fecha_hasta']" t-options="{'widget': 'date'}"/>
                        </div>
                    </div>
                    <t t-set="result" t-value="lineas(data)"/>
                    <t t-set="sal_ant" t-value="saldo_anterior(data)"/>
                    <table class="table table-condensed" style="font-size:11px;">
                        <thead>
                            <tr>
                                <th>Fecha</th><th>Documento</th><th>Concepto</th>
                                <th class="text-right text-end">Debe</th>
                                <th class="text-right text-end">Haber</th>
                                <th class="text-right text-end">Saldo</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td></td><td></td><td><strong>Saldo anterior</strong></td>
                                <td></td><td></td>
                                <td class="text-right text-end"><strong><span t-esc="sal_ant" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong></td>
                            </tr>
                            <tr t-foreach="result['lineas']" t-as="l">
                                <td><span t-esc="l['fecha']" t-options="{'widget': 'date'}"/></td>
                                <td><span t-esc="l['documento']"/></td>
                                <td><span t-esc="l['concepto']"/></td>
                                <td class="text-right text-end"><span t-esc="l['debe']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right text-end"><span t-esc="l['haber']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right text-end"><span t-esc="l['saldo']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3"><strong>Totales</strong></td>
                                <td class="text-right text-end"><strong><span t-esc="result['totales']['debe']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong></td>
                                <td class="text-right text-end"><strong><span t-esc="result['totales']['haber']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong></td>
                                <td class="text-right text-end"><strong><span t-esc="result['totales']['saldo']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
