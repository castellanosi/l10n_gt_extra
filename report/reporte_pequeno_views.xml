<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="reporte_pequeno">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="row mb-2 mt-2">
                        <div class="col-12">
                            <h4 style="margin:0; border-bottom:1px solid #ccc; padding-bottom:4px;">
                                Libro de <span t-esc="'Compras' if data.get('tipo') == 'compra' else 'Ventas'"/> — Pequeño Contribuyente
                            </h4>
                        </div>
                    </div>
                    <div class="row mb-3" style="font-size:12px;">
                        <div class="col-6">
                            <strong>NIT:</strong> <span t-field="current_company_id.vat"/><br/>
                            <strong>Empresa:</strong> <span t-esc="direccion_diario.name if direccion_diario else current_company_id.partner_id.name"/>
                        </div>
                        <div class="col-6">
                            <strong>Registro del:</strong>
                            <span t-esc="data['fecha_desde']" t-options="{'widget': 'date'}"/>
                            al <span t-esc="data['fecha_hasta']" t-options="{'widget': 'date'}"/>
                        </div>
                    </div>
                    <t t-set="result" t-value="lineas(data)"/>
                    <table class="table table-condensed" style="font-size:11px;">
                        <thead>
                            <tr>
                                <th>Fecha</th><th>Tipo</th><th>Documento</th>
                                <th>Proveedor / Cliente</th><th>NIT</th>
                                <th class="text-right text-end">Total Factura</th>
                                <th class="text-right text-end">Cuota (5%)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="result['lineas']" t-as="l">
                                <td><span t-esc="l['fecha']" t-options="{'widget': 'date'}"/></td>
                                <td><span t-esc="l['tipo']"/><t t-if="l['pequeno']"> <small>PEQ</small></t></td>
                                <td><span t-esc="l['numero']"/></td>
                                <td><span t-esc="l['partner']"/></td>
                                <td><span t-esc="l['nit']"/></td>
                                <td class="text-right text-end"><span t-esc="l['total']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right text-end"><span t-esc="l['cuota']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="5"><strong>Totales (<span t-esc="result['totales']['num_facturas']"/> documentos)</strong></td>
                                <td class="text-right text-end"><strong><span t-esc="result['totales']['total']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong></td>
                                <td class="text-right text-end"><strong><span t-esc="result['totales']['cuota']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
