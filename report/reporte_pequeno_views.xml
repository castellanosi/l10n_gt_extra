<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="reporte_pequeno">
        <t t-call="web.html_container">
            <t t-set="data_report_margin_top" t-value="30"/>
            <t t-set="data_report_header_spacing" t-value="20"/>
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>
                        <span t-field="current_company_id.name"/>:
                        Libro de <span t-esc="'Compras' if data.get('tipo') == 'compra' else 'Ventas'"/> — Pequeño Contribuyente
                    </h2>

                    <div class="row my-2">
                        <div class="col-6">
                            <strong>NIT:</strong> <span t-field="current_company_id.vat"/><br/>
                            <strong>Empresa:</strong>
                            <span t-esc="direccion_diario.name if direccion_diario else current_company_id.partner_id.name"/>
                        </div>
                        <div class="col-6">
                            <strong>Domicilio fiscal:</strong>
                            <span t-esc="direccion_diario.street if direccion_diario else current_company_id.partner_id.street"/><br/>
                            <strong>Registro del:</strong>
                            <span t-esc="data['fecha_desde']" t-options="{'widget': 'date'}"/>
                            al <span t-esc="data['fecha_hasta']" t-options="{'widget': 'date'}"/>
                        </div>
                    </div>

                    <t t-set="result" t-value="lineas(data)"/>

                    <table class="table table-condensed">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Tipo</th>
                                <th>Documento</th>
                                <th>Proveedor / Cliente</th>
                                <th>NIT</th>
                                <th class="text-right text-end">Total Factura</th>
                                <th class="text-right text-end">Cuota (5%)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="result['lineas']" t-as="l">
                                <td><span t-esc="l['fecha']" t-options="{'widget': 'date'}"/></td>
                                <td>
                                    <span t-esc="l['tipo']"/>
                                    <t t-if="l['pequeno']">
                                        <span class="badge bg-secondary ms-1" style="font-size:9px;">PEQ</span>
                                    </t>
                                </td>
                                <td><span t-esc="l['numero']"/></td>
                                <td><span t-esc="l['partner']"/></td>
                                <td><span t-esc="l['nit']"/></td>
                                <td class="text-right text-end">
                                    <span t-esc="l['total']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-right text-end">
                                    <span t-esc="l['cuota']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="5">
                                    <strong>Totales (<span t-esc="result['totales']['num_facturas']"/> documentos)</strong>
                                </td>
                                <td class="text-right text-end">
                                    <strong><span t-esc="result['totales']['total']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong>
                                </td>
                                <td class="text-right text-end">
                                    <strong><span t-esc="result['totales']['cuota']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong>
                                </td>
                            </tr>
                        </tfoot>
                    </table>

                    <div class="row mt-2">
                        <div class="col-6">
                            <strong>Total a pagar (cuota mensual):</strong>
                        </div>
                        <div class="col-6">
                            <span t-esc="result['totales']['cuota']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
