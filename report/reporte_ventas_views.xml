<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 5.66: columna «Impuestos y contrib.» (impuestos distintos del IVA:
         IDP, Tasa Municipal, Turismo, Timbre...), combustible en ventas,
         «Imp.» de compras pasa a «Import.» (importaciones) y pie «Control». -->
    <template id="reporte_ventas">
        <t t-call="web.html_container">
            <t t-set="data_report_margin_top" t-value="40"/>
            <t t-set="data_report_header_spacing" t-value="34"/>
            <t t-call="l10n_gt_extra.encabezado_folio">
                <t t-set="titulo" t-value="'Libro de Ventas y Servicios'"/>
            </t>
            <t t-call="l10n_gt_extra.cuerpo_reporte">
                <div class="page">
                    <div style="font-size: 12px; margin-bottom: 8px;">
                        <t t-if="direccion_diario">
                            <strong>Establecimiento:</strong> <span t-esc="direccion_diario.name"/> —
                            <span t-esc="direccion_diario.street"/>
                        </t></div>

                    <t t-set="result" t-value="lineas(data)"/>

                    <table class="table table-condensed">
                        <thead>
                            <tr>
                                <th>Tipo</th>
                                <th>Fecha</th>
                                <th>Doc</th>
                                <th>Cliente</th>
                                <th>NIT</th>
                            <th class="text-right">Vent.</th>
                            <th class="text-right">Vent. Exe.</th>
                            <th class="text-right">Serv.</th>
                            <th class="text-right">Serv. Exe.</th>
                            <th class="text-right">Comb.</th>
                            <th class="text-right">Comb. Exe.</th>
                            <th class="text-right">Exp.</th>
                            <th class="text-right">Impuestos<br/>y contrib.</th>
                            <th class="text-right">IVA</th>
                            <th class="text-right">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="result['lineas']" t-as="l">
                                <td class="l10n_gt_nowrap"><span t-esc="l['tipo']"/></td>
                                <td class="l10n_gt_nowrap"><span t-esc="l['fecha']" t-options='{"widget": "date"}'/></td>
                                <td class="l10n_gt_nowrap"><span t-esc="l['numero']"/></td>
                                <td><span t-esc="l['cliente']"/></td>
                                <td class="l10n_gt_nowrap"><span t-esc="l['nit']"/></td>
                                <td class="text-right"><span t-esc="l['compra']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="l['compra_exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="l['servicio']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="l['servicio_exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="l['combustible']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="l['combustible_exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="l['importacion']+l['importacion_exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="l['otros']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="l['iva']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="l['total']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                            </tr>
                            <tr>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td>Totales</td>
                                <td></td>
                                <td class="text-right"><span t-esc="result['totales']['compra']['neto']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="result['totales']['compra']['exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="result['totales']['servicio']['neto']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="result['totales']['servicio']['exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="result['totales']['combustible']['neto']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="result['totales']['combustible']['exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="result['totales']['importacion']['neto']+result['totales']['importacion']['exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="result['totales']['otros']['total']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="result['totales']['general']['iva']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="result['totales']['general']['total']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="row mt-2">
                        <div class="col-6"><strong>Cantidad de facturas:</strong></div>
                        <div class="col-6"><span t-esc="'{0:,.0f}'.format(result['totales']['num_facturas'])"/></div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-6"><strong>Total débito fiscal:</strong></div>
                        <div class="col-6"><span t-esc="result['totales']['general']['iva']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></div>
                    </div>

                    <div><strong>Resumen:</strong></div>
                    <table class="table table-condensed">
                        <thead>
                            <tr>
                                <th></th>
                                <th class="text-right">Exento</th>
                                <th class="text-right">Neto</th>
                                <th class="text-right">IVA</th>
                                <th class="text-right">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Bienes</td>
                                <td class="text-right"><span t-esc="result['totales']['compra']['exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="result['totales']['compra']['neto']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="result['totales']['compra']['iva']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="result['totales']['compra']['total']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                            </tr>
                            <tr>
                                <td>Servicios</td>
                                <td class="text-right"><span t-esc="result['totales']['servicio']['exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="result['totales']['servicio']['neto']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="result['totales']['servicio']['iva']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="result['totales']['servicio']['total']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                            </tr>
                            <tr>
                                <td>Combustibles</td>
                                <td class="text-right"><span t-esc="result['totales']['combustible']['exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="result['totales']['combustible']['neto']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="result['totales']['combustible']['iva']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="result['totales']['combustible']['total']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                            </tr>
                            <tr>
                                <td>Exportaciones</td>
                                <td class="text-right"><span t-esc="result['totales']['importacion']['exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="result['totales']['importacion']['neto']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="result['totales']['importacion']['iva']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="result['totales']['importacion']['total']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                            </tr>
                            <tr>
                                <td>Impuestos y contribuciones</td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td class="text-right"><span t-esc="result['totales']['otros']['total']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td>Totales</td>
                                <td class="text-right"><span t-esc="result['totales']['general']['exento']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="result['totales']['general']['neto']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="result['totales']['general']['iva']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right"><span t-esc="result['totales']['general']['total']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                            </tr>
                        </tfoot>
                    </table>

                    <!-- Pie de control: solo con la casilla «Incluir control» del asistente -->
                    <t t-set="control" t-value="result.get('control')"/>
                    <div t-if="control" style="font-size: 11px; page-break-inside: avoid;">
                        <div><strong>Control:</strong></div>
                        <table class="table table-condensed" style="width: 60%;">
                            <tbody>
                                <tr>
                                    <td>IVA del libro (IVA de los DTE)</td>
                                    <td class="text-right"><span t-esc="control['iva_libro']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                </tr>
                                <tr>
                                    <td>IVA contable de las mismas facturas</td>
                                    <td class="text-right"><span t-esc="control['iva_contable']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                </tr>
                                <tr>
                                    <td>Diferencia</td>
                                    <td class="text-right"><span t-esc="control['diferencia']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                </tr>
                                <tr>
                                    <td style="padding-left: 20px;">Por redondeo del IVA de los DTE (se ajusta en la liquidación de IVA)</td>
                                    <td class="text-right"><span t-esc="control['redondeo_dte']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                </tr>
                                <tr t-att-style="control['otras_diferencias'] and 'color: red; font-weight: bold;' or None">
                                    <td style="padding-left: 20px;">Otras diferencias (revisar antes de declarar)</td>
                                    <td class="text-right"><span t-esc="control['otras_diferencias']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                </tr>
                                <tr>
                                    <td>Documentos con IVA del DTE</td>
                                    <td class="text-right"><span t-esc="control['dte_usados']"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div t-foreach="control['mensajes']" t-as="mensaje">
                            <span t-esc="mensaje"/>
                        </div>
                        <t t-if="control['documentos']">
                            <div class="mt-2" style="color: red;"><strong>Documentos cuyo IVA en el libro no es igual al de su asiento:</strong></div>
                            <table class="table table-condensed" style="width: 60%;">
                                <thead>
                                    <tr>
                                        <th>Documento</th>
                                        <th class="text-right">IVA libro</th>
                                        <th class="text-right">IVA contable</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="control['documentos']" t-as="d">
                                        <td class="l10n_gt_nowrap"><span t-esc="d['numero']"/></td>
                                        <td class="text-right"><span t-esc="d['iva_libro']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                        <td class="text-right"><span t-esc="d['iva_contable']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <t t-if="control['hallazgos']">
                            <div class="mt-2"><strong>Documentos que no cuadran con el DTE (se dejaron como se calcularon):</strong></div>
                            <div t-foreach="control['hallazgos']" t-as="h">
                                <span t-esc="h['numero']"/> — <span t-esc="h['motivo']"/>
                            </div>
                        </t>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
