<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="reporte_conciliacion">
        <t t-call="web.html_container">
            <t t-set="data_report_page_offset" t-value="data.get('folio_inicial', 1) + 1"/>
            <t t-set="data_report_margin_top" t-value="30"/>
            <t t-set="data_report_header_spacing" t-value="20"/>
            <div class="header">
                Folio: <span class="page" t-esc="data.get('folio_inicial', 1) - 1"/>
            </div>
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="row mb-2 mt-2">
                        <div class="col-12">
                            <h4 style="margin:0; border-bottom:1px solid #ccc; padding-bottom:4px;">
                                Conciliación Bancaria
                            </h4>
                        </div>
                    </div>
                    <div class="row mb-3" style="font-size:12px;">
                        <div class="col-6">
                            <strong>NIT:</strong> <span t-field="current_company_id.vat"/><br/>
                            <strong>Cuenta:</strong> <span t-esc="data['cuenta_id'][1]"/>
                        </div>
                        <div class="col-6">
                            <strong>Al:</strong>
                            <span t-esc="data['fecha_hasta']" t-options="{'widget': 'date'}"/>
                        </div>
                    </div>
                    <t t-set="res" t-value="datos(data)"/>
                    <div class="row mt-2">
                        <div class="col-6">
                            <table class="table table-condensed table-bordered" style="font-size:11px;">
                                <thead><tr class="table-light"><th colspan="2"><strong>Saldo según banco</strong></th></tr></thead>
                                <tbody>
                                    <tr>
                                        <td>Saldo extracto bancario</td>
                                        <td class="text-right text-end"><span t-esc="res['saldo_banco']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                    </tr>
                                </tbody>
                            </table>
                            <strong style="font-size:11px;">Más: Depósitos en tránsito</strong>
                            <table class="table table-condensed" style="font-size:10px;">
                                <thead><tr><th>Fecha</th><th>Doc.</th><th>Concepto</th><th class="text-right text-end">Monto</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="res['depositos_transito']" t-as="d">
                                        <td><span t-esc="d['fecha']" t-options="{'widget': 'date'}"/></td>
                                        <td><span t-esc="d['documento']"/></td>
                                        <td><span t-esc="d['concepto']"/></td>
                                        <td class="text-right text-end"><span t-esc="d['monto']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                    </tr>
                                    <tr><td colspan="3"><strong>Total depósitos en tránsito</strong></td>
                                        <td class="text-right text-end"><strong><span t-esc="res['total_depositos']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong></td></tr>
                                </tbody>
                            </table>
                            <strong style="font-size:11px;">Menos: Cheques pendientes</strong>
                            <table class="table table-condensed" style="font-size:10px;">
                                <thead><tr><th>Fecha</th><th>Doc.</th><th>Concepto</th><th class="text-right text-end">Monto</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="res['cheques_pendientes']" t-as="c">
                                        <td><span t-esc="c['fecha']" t-options="{'widget': 'date'}"/></td>
                                        <td><span t-esc="c['documento']"/></td>
                                        <td><span t-esc="c['concepto']"/></td>
                                        <td class="text-right text-end"><span t-esc="c['monto']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                    </tr>
                                    <tr><td colspan="3"><strong>Total cheques pendientes</strong></td>
                                        <td class="text-right text-end"><strong><span t-esc="res['total_cheques']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong></td></tr>
                                </tbody>
                            </table>
                            <table class="table table-condensed table-bordered" style="font-size:11px;">
                                <tbody>
                                    <tr class="table-light">
                                        <td><strong>Saldo ajustado banco</strong></td>
                                        <td class="text-right text-end"><strong><span t-esc="res['saldo_ajustado_banco']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="col-6">
                            <table class="table table-condensed table-bordered" style="font-size:11px;">
                                <thead><tr class="table-light"><th colspan="2"><strong>Saldo según libros</strong></th></tr></thead>
                                <tbody>
                                    <tr class="table-light">
                                        <td><strong>Saldo libro contable</strong></td>
                                        <td class="text-right text-end"><strong><span t-esc="res['saldo_libro']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <table class="table table-condensed table-bordered mt-2" style="font-size:11px;">
                        <tbody>
                            <tr>
                                <td><strong>Diferencia (Banco ajustado - Libros)</strong></td>
                                <td class="text-right text-end"><strong><span t-esc="res['diferencia']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong></td>
                                <td><t t-if="abs(res['diferencia']) &lt; 0.01"><span style="color:green;font-weight:bold;">✓ CONCILIADO</span></t><t t-else=""><span style="color:red;font-weight:bold;">⚠ DIFERENCIA</span></t></td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="row mt-4">
                        <div class="col-4 text-center"><br/><br/><div style="border-top:1px solid black; padding-top:4px; font-size:11px;">Preparado por</div></div>
                        <div class="col-4 text-center"><br/><br/><div style="border-top:1px solid black; padding-top:4px; font-size:11px;">Revisado por</div></div>
                        <div class="col-4 text-center"><br/><br/><div style="border-top:1px solid black; padding-top:4px; font-size:11px;">Autorizado por</div></div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
