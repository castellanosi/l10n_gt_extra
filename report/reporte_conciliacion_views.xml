<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="reporte_conciliacion">
        <t t-call="web.html_container">
            <t t-set="data_report_page_offset" t-value="data.get('folio_inicial', 1) + 1"/>
            <t t-call="web.external_layout">
                <div class="page">

                    <!-- ── Título ─────────────────────────────────────── -->
                    <div class="row mb-2 mt-2">
                        <div class="col-12">
                            <h4 style="margin:0; border-bottom:2px solid #333; padding-bottom:6px; text-transform:uppercase; letter-spacing:1px;">
                                Conciliación Bancaria
                            </h4>
                        </div>
                    </div>

                    <!-- ── Datos generales ────────────────────────────── -->
                    <div class="row mb-3" style="font-size:11px; background:#f8f8f8; padding:6px 0; border-bottom:1px solid #ddd;">
                        <div class="col-4">
                            <strong>Empresa:</strong>
                            <span t-field="current_company_id.name"/>
                        </div>
                        <div class="col-4">
                            <strong>NIT:</strong>
                            <span t-field="current_company_id.vat"/><br/>
                            <strong>Cuenta:</strong>
                            <span t-esc="data['cuenta_id'][1]"/>
                        </div>
                        <div class="col-4" style="text-align:right;">
                            <t t-if="data.get('fecha_desde')">
                                <strong>Del:</strong>
                                <span t-esc="data['fecha_desde']" t-options="{'widget': 'date'}"/>
                                &#160;
                                <strong>Al:</strong>
                            </t>
                            <t t-else="">
                                <strong>Al:</strong>
                            </t>
                            <span t-esc="data['fecha_hasta']" t-options="{'widget': 'date'}"/>
                        </div>
                    </div>

                    <t t-set="res" t-value="datos(data)"/>

                    <!-- ── Cuerpo principal ───────────────────────────── -->
                    <table class="table table-sm" style="font-size:11px; width:100%;">

                        <!-- Saldo extracto bancario -->
                        <tbody>
                            <tr style="background:#e8f4fd;">
                                <td style="width:55%; padding:6px 8px; font-weight:bold; border:1px solid #c0d8ec;">
                                    Saldo según extracto bancario
                                </td>
                                <td style="width:45%; padding:6px 8px; text-align:right; font-weight:bold; border:1px solid #c0d8ec;">
                                    <span t-esc="res['saldo_banco']"
                                          t-options="{'widget':'monetary','display_currency':current_company_id.currency_id}"/>
                                </td>
                            </tr>
                        </tbody>

                        <!-- Sección MÁS -->
                        <tbody>
                            <tr>
                                <td colspan="2" style="padding:8px 8px 2px; font-weight:bold; font-size:11px; border:none; border-bottom:1px solid #aaa;">
                                    MÁS: Depósitos y notas de crédito en tránsito
                                </td>
                            </tr>
                            <tr style="background:#f0f0f0; font-size:10px;">
                                <td style="padding:3px 8px; border:1px solid #ddd;"><strong>Fecha&#160;&#160;&#160;&#160;Doc. / Referencia&#160;&#160;&#160;&#160;Concepto</strong></td>
                                <td style="padding:3px 8px; text-align:right; border:1px solid #ddd;"><strong>Monto</strong></td>
                            </tr>
                            <tr t-foreach="res['depositos_transito']" t-as="d">
                                <td style="padding:2px 8px; border:1px solid #eee; font-size:10px;">
                                    <span t-esc="d['fecha']" t-options="{'widget':'date'}"/>
                                    &#160;&#160;
                                    <span t-esc="d['documento']"/>
                                    &#160;&#160;
                                    <span t-esc="d['concepto']" style="color:#555;"/>
                                </td>
                                <td style="padding:2px 8px; text-align:right; border:1px solid #eee; font-size:10px;">
                                    <span t-esc="d['monto']"
                                          t-options="{'widget':'monetary','display_currency':current_company_id.currency_id}"/>
                                </td>
                            </tr>
                            <tr t-if="not res['depositos_transito']">
                                <td colspan="2" style="padding:2px 8px; font-size:10px; color:#888; font-style:italic; border:1px solid #eee;">
                                    No hay depósitos en tránsito
                                </td>
                            </tr>
                            <tr style="background:#f0f0f0;">
                                <td style="padding:4px 8px; border:1px solid #ddd; font-weight:bold; font-size:10px; text-align:right;">
                                    Total depósitos y notas de crédito en tránsito
                                </td>
                                <td style="padding:4px 8px; text-align:right; border:1px solid #ddd; font-weight:bold; font-size:10px;">
                                    <span t-esc="res['total_depositos']"
                                          t-options="{'widget':'monetary','display_currency':current_company_id.currency_id}"/>
                                </td>
                            </tr>
                        </tbody>

                        <!-- Sección MENOS -->
                        <tbody>
                            <tr>
                                <td colspan="2" style="padding:8px 8px 2px; font-weight:bold; font-size:11px; border:none; border-bottom:1px solid #aaa;">
                                    MENOS: Cheques y notas de débito pendientes
                                </td>
                            </tr>
                            <tr style="background:#f0f0f0; font-size:10px;">
                                <td style="padding:3px 8px; border:1px solid #ddd;"><strong>Fecha&#160;&#160;&#160;&#160;Doc. / Referencia&#160;&#160;&#160;&#160;Concepto</strong></td>
                                <td style="padding:3px 8px; text-align:right; border:1px solid #ddd;"><strong>Monto</strong></td>
                            </tr>
                            <tr t-foreach="res['cheques_pendientes']" t-as="c">
                                <td style="padding:2px 8px; border:1px solid #eee; font-size:10px;">
                                    <span t-esc="c['fecha']" t-options="{'widget':'date'}"/>
                                    &#160;&#160;
                                    <span t-esc="c['documento']"/>
                                    &#160;&#160;
                                    <span t-esc="c['concepto']" style="color:#555;"/>
                                </td>
                                <td style="padding:2px 8px; text-align:right; border:1px solid #eee; font-size:10px;">
                                    <span t-esc="c['monto']"
                                          t-options="{'widget':'monetary','display_currency':current_company_id.currency_id}"/>
                                </td>
                            </tr>
                            <tr t-if="not res['cheques_pendientes']">
                                <td colspan="2" style="padding:2px 8px; font-size:10px; color:#888; font-style:italic; border:1px solid #eee;">
                                    No hay cheques ni notas de débito pendientes
                                </td>
                            </tr>
                            <tr style="background:#f0f0f0;">
                                <td style="padding:4px 8px; border:1px solid #ddd; font-weight:bold; font-size:10px; text-align:right;">
                                    Total cheques y notas de débito pendientes
                                </td>
                                <td style="padding:4px 8px; text-align:right; border:1px solid #ddd; font-weight:bold; font-size:10px;">
                                    <span t-esc="res['total_cheques']"
                                          t-options="{'widget':'monetary','display_currency':current_company_id.currency_id}"/>
                                </td>
                            </tr>
                        </tbody>

                        <!-- Saldo ajustado -->
                        <tbody>
                            <tr style="background:#e8f4fd;">
                                <td style="padding:6px 8px; font-weight:bold; border:1px solid #c0d8ec;">
                                    Saldo ajustado banco
                                </td>
                                <td style="padding:6px 8px; text-align:right; font-weight:bold; border:1px solid #c0d8ec;">
                                    <span t-esc="res['saldo_ajustado_banco']"
                                          t-options="{'widget':'monetary','display_currency':current_company_id.currency_id}"/>
                                </td>
                            </tr>
                        </tbody>

                        <!-- Separador -->
                        <tbody><tr><td colspan="2" style="border:none; padding:4px;"/></tr></tbody>

                        <!-- Saldo libros -->
                        <tbody>
                            <tr style="background:#e8f4fd;">
                                <td style="padding:6px 8px; font-weight:bold; border:1px solid #c0d8ec;">
                                    Saldo según libros contables
                                </td>
                                <td style="padding:6px 8px; text-align:right; font-weight:bold; border:1px solid #c0d8ec;">
                                    <span t-esc="res['saldo_libro']"
                                          t-options="{'widget':'monetary','display_currency':current_company_id.currency_id}"/>
                                </td>
                            </tr>
                        </tbody>

                        <!-- Diferencia -->
                        <tbody>
                            <tr><td colspan="2" style="border:none; padding:4px;"/></tr>
                            <tr>
                                <t t-if="abs(res['diferencia']) &lt; 0.01">
                                    <td style="padding:8px; font-weight:bold; border:2px solid #1a7a1a; background:#d4edda; color:#1a7a1a; font-size:12px;">
                                        Diferencia (Banco ajustado - Libros)
                                    </td>
                                    <td style="padding:8px; text-align:right; font-weight:bold; border:2px solid #1a7a1a; background:#d4edda; color:#1a7a1a; font-size:12px;">
                                        <span t-esc="res['diferencia']"
                                              t-options="{'widget':'monetary','display_currency':current_company_id.currency_id}"/>
                                        &#160; &#10003; CONCILIADO
                                    </td>
                                </t>
                                <t t-else="">
                                    <td style="padding:8px; font-weight:bold; border:2px solid #c00; background:#fde8e8; color:#c00; font-size:12px;">
                                        Diferencia (Banco ajustado - Libros)
                                    </td>
                                    <td style="padding:8px; text-align:right; font-weight:bold; border:2px solid #c00; background:#fde8e8; color:#c00; font-size:12px;">
                                        <span t-esc="res['diferencia']"
                                              t-options="{'widget':'monetary','display_currency':current_company_id.currency_id}"/>
                                        &#160; &#9651; DIFERENCIA
                                    </td>
                                </t>
                            </tr>
                        </tbody>

                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
