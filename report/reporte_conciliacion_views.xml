<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bloque de movimientos en tránsito. Espera `titulo`, `filas`,
         `vacio`, `total_titulo` y `total`. -->
    <template id="conciliacion_bloque">
        <tr>
            <td colspan="4" style="padding:8px 4px 2px; font-weight:bold; border:none; border-bottom:1px solid #aaa;">
                <span t-esc="titulo"/>
            </td>
        </tr>
        <tr style="background:#ede9f7; font-weight:bold;">
            <td class="l10n_gt_nowrap">Fecha</td>
            <td class="l10n_gt_nowrap">Documento</td>
            <td>Concepto</td>
            <td class="text-right text-end l10n_gt_nowrap">Monto</td>
        </tr>
        <tr t-foreach="filas" t-as="r">
            <td class="l10n_gt_nowrap"><span t-esc="r['fecha']" t-options="{'widget': 'date'}"/></td>
            <td class="l10n_gt_nowrap"><span t-esc="r['documento']"/></td>
            <td><span t-esc="r['concepto']"/></td>
            <td class="text-right text-end l10n_gt_nowrap"><span t-esc="formato(r['monto'])"/></td>
        </tr>
        <tr t-if="not filas">
            <td colspan="4" style="color:#888; font-style:italic;"><span t-esc="vacio"/></td>
        </tr>
        <tr style="font-weight:bold; border-top:1px solid #000;">
            <td colspan="3" class="text-right text-end"><span t-esc="total_titulo"/></td>
            <td class="text-right text-end l10n_gt_nowrap"><span t-esc="formato(total)"/></td>
        </tr>
    </template>

    <template id="reporte_conciliacion">
        <t t-call="web.html_container">
            <t t-set="data_report_margin_top" t-value="40"/>
            <t t-set="data_report_header_spacing" t-value="34"/>
            <t t-call="l10n_gt_extra.encabezado_folio">
                <t t-set="titulo" t-value="'Conciliación Bancaria'"/>
            </t>
            <t t-call="l10n_gt_extra.cuerpo_reporte">
                <div class="page">
                    <t t-set="res" t-value="datos(data)"/>
                    <div style="font-size: 12px; margin-bottom: 8px;">
                        <strong>Cuenta:</strong> <span t-esc="data['cuenta_id'][1]"/>
                        · Expresado en <span t-esc="current_company_id.currency_id.currency_unit_label or current_company_id.currency_id.name"/>
                    </div>
                    <table class="table table-condensed" style="font-size: 11px;">
                        <tbody>
                            <tr style="background:#f4f2fb; font-weight:bold;">
                                <td colspan="3">Saldo según libros</td>
                                <td class="text-right text-end l10n_gt_nowrap"><span t-esc="formato(res['saldo_libro'])"/></td>
                            </tr>
                            <t t-call="l10n_gt_extra.conciliacion_bloque">
                                <t t-set="titulo" t-value="'MÁS: Cheques y débitos en tránsito'"/>
                                <t t-set="filas" t-value="res['cheques_pendientes']"/>
                                <t t-set="vacio" t-value="'No hay cheques ni débitos en tránsito'"/>
                                <t t-set="total_titulo" t-value="'Total cheques y débitos en tránsito'"/>
                                <t t-set="total" t-value="res['total_cheques']"/>
                            </t>
                            <t t-call="l10n_gt_extra.conciliacion_bloque">
                                <t t-set="titulo" t-value="'MENOS: Depósitos y créditos en tránsito'"/>
                                <t t-set="filas" t-value="res['depositos_transito']"/>
                                <t t-set="vacio" t-value="'No hay depósitos ni créditos en tránsito'"/>
                                <t t-set="total_titulo" t-value="'Total depósitos y créditos en tránsito'"/>
                                <t t-set="total" t-value="res['total_depositos']"/>
                            </t>
                            <tr><td colspan="4" style="border:none;">&#160;</td></tr>
                            <tr style="background:#f4f2fb; font-weight:bold;">
                                <td colspan="3">Saldo según banco (calculado)</td>
                                <td class="text-right text-end l10n_gt_nowrap"><span t-esc="formato(res['saldo_banco_calculado'])"/></td>
                            </tr>
                            <tr>
                                <td colspan="3">Saldo según estado de cuenta del banco</td>
                                <td class="text-right text-end l10n_gt_nowrap"><span t-esc="formato(res['saldo_banco'])"/></td>
                            </tr>
                            <t t-set="cuadra" t-value="abs(res['diferencia']) &lt; 0.01"/>
                            <tr t-attf-style="font-weight:bold; color: {{'#1a7a1a' if cuadra else '#c00'}}; background: {{'#d4edda' if cuadra else '#fde8e8'}};">
                                <td colspan="3">Diferencia (debe ser 0.00)<t t-if="cuadra"> &#10003; CONCILIADO</t></td>
                                <td class="text-right text-end l10n_gt_nowrap"><span t-esc="formato(res['diferencia'])"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="row mt-4">
                        <div class="col-6 text-center"><br/><br/><div style="border-top:1px solid black; padding-top:4px; font-size:11px;">Elaborado por</div></div>
                        <div class="col-6 text-center"><br/><br/><div style="border-top:1px solid black; padding-top:4px; font-size:11px;">Revisado por</div></div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
