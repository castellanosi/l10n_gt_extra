<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="reporte_balance_saldos">
        <t t-call="web.html_container">
            <t t-set="data_report_margin_top" t-value="30"/>
            <t t-set="data_report_header_spacing" t-value="20"/>
            <t t-call="web.external_layout">
                <div class="page">
                    <h2><span t-field="current_company_id.name"/>: Balanza de Comprobación</h2>

                    <div class="row my-2">
                        <div class="col-6">
                            <strong>NIT:</strong> <span t-field="current_company_id.vat"/><br/>
                            <strong>Empresa:</strong> <span t-field="current_company_id.partner_id.name"/>
                        </div>
                        <div class="col-6">
                            <strong>Período del:</strong>
                            <span t-esc="data['fecha_desde']" t-options="{'widget': 'date'}"/>
                            al <span t-esc="data['fecha_hasta']" t-options="{'widget': 'date'}"/><br/>
                            <strong>Cuentas:</strong>
                            <span t-esc="{'todas': 'Todas', 'balance': 'Balance General', 'resultados': 'Estado de Resultados'}.get(data.get('filtro_tipo','todas'), 'Todas')"/>
                        </div>
                    </div>

                    <t t-set="result" t-value="lineas(data)"/>

                    <table class="table table-condensed" style="font-size:11px;">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Cuenta</th>
                                <th class="text-right text-end">Saldo Anterior</th>
                                <th class="text-right text-end">Debe</th>
                                <th class="text-right text-end">Haber</th>
                                <th class="text-right text-end">Saldo Deudor</th>
                                <th class="text-right text-end">Saldo Acreedor</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="result['lineas']" t-as="l">
                                <td><span t-esc="l['codigo']"/></td>
                                <td><span t-esc="l['cuenta']"/></td>
                                <td class="text-right text-end">
                                    <span t-esc="l['saldo_anterior']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-right text-end">
                                    <span t-esc="l['debe']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-right text-end">
                                    <span t-esc="l['haber']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-right text-end">
                                    <span t-esc="l['saldo_deudor']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                                <td class="text-right text-end">
                                    <span t-esc="l['saldo_acreedor']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="2"><strong>Totales</strong></td>
                                <td class="text-right text-end">
                                    <strong><span t-esc="result['totales']['saldo_anterior']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong>
                                </td>
                                <td class="text-right text-end">
                                    <strong><span t-esc="result['totales']['debe']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong>
                                </td>
                                <td class="text-right text-end">
                                    <strong><span t-esc="result['totales']['haber']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong>
                                </td>
                                <td class="text-right text-end">
                                    <strong><span t-esc="result['totales']['saldo_deudor']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong>
                                </td>
                                <td class="text-right text-end">
                                    <strong><span t-esc="result['totales']['saldo_acreedor']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
