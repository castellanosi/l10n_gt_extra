<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="reporte_balance_saldos">
        <t t-call="web.html_container">
            <t t-set="data_report_margin_top" t-value="40"/>
            <t t-set="data_report_header_spacing" t-value="34"/>
            <t t-call="l10n_gt_extra.encabezado_folio">
                <t t-set="titulo" t-value="'Balanza de Comprobación'"/>
            </t>
            <t t-call="l10n_gt_extra.cuerpo_reporte">
                <div class="page">
                    <div style="font-size: 12px; margin-bottom: 8px;">
                        <strong>Cuentas:</strong>
                        <span t-esc="{'todas': 'Todas', 'balance': 'Balance General', 'resultados': 'Estado de Resultados'}.get(data.get('filtro_tipo','todas'), 'Todas')"/></div>
                    <t t-set="result" t-value="lineas(data)"/>
                    <table class="table table-condensed" style="font-size:10px;">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Cuenta</th>
                                <th class="text-right text-end">Saldo Anterior</th>
                                <th class="text-right text-end">Debe</th>
                                <th class="text-right text-end">Haber</th>
                                <th class="text-right text-end">Saldo Deudor</th>
                                <th class="text-right text-end">Saldo Acreedor</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="result['lineas']" t-as="l">
                                <td><span t-esc="l['codigo']"/></td>
                                <td><span t-esc="l['cuenta']"/></td>
                                <td class="text-right text-end"><span t-esc="l['saldo_anterior']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right text-end"><span t-esc="l['debe']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right text-end"><span t-esc="l['haber']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right text-end"><span t-esc="l['saldo_deudor']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right text-end"><span t-esc="l['saldo_acreedor']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="2"><strong>Totales</strong></td>
                                <td class="text-right text-end"><strong><span t-esc="result['totales']['saldo_anterior']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong></td>
                                <td class="text-right text-end"><strong><span t-esc="result['totales']['debe']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong></td>
                                <td class="text-right text-end"><strong><span t-esc="result['totales']['haber']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong></td>
                                <td class="text-right text-end"><strong><span t-esc="result['totales']['saldo_deudor']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong></td>
                                <td class="text-right text-end"><strong><span t-esc="result['totales']['saldo_acreedor']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
