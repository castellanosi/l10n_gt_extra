<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="reporte_isr">
        <t t-call="web.html_container">
            <t t-set="data_report_margin_top" t-value="40"/>
            <t t-set="data_report_header_spacing" t-value="34"/>
            <t t-call="l10n_gt_extra.encabezado_folio">
                <t t-set="titulo" t-value="'Reporte de Retenciones ISR'"/>
            </t>
            <t t-call="l10n_gt_extra.cuerpo_reporte">
                <div class="page">
                    <div style="font-size: 12px; margin-bottom: 8px;">
                        <strong>Tipo:</strong>
                        <span t-esc="'Compras' if data.get('tipo_reporte') == 'compra' else 'Ventas'"/></div>
                    <t t-set="result" t-value="lineas(data)"/>
                    <table class="table table-condensed" style="font-size:11px;">
                        <thead>
                            <tr>
                                <th>Fecha</th><th>Tipo</th><th>Documento</th>
                                <th>Proveedor / Cliente</th><th>NIT</th>
                                <th class="text-right text-end">Base Imponible</th>
                                <th class="text-right text-end">ISR Retenido</th>
                                <th class="text-right text-end">Total Factura</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="result['lineas']" t-as="l">
                                <td><span t-esc="l['fecha']" t-options="{'widget': 'date'}"/></td>
                                <td><span t-esc="l['tipo']"/></td>
                                <td><span t-esc="l['numero']"/></td>
                                <td><span t-esc="l['proveedor']"/></td>
                                <td><span t-esc="l['nit']"/></td>
                                <td class="text-right text-end"><span t-esc="l['base']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right text-end"><span t-esc="l['isr']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                                <td class="text-right text-end"><span t-esc="l['total']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="5"><strong>Totales (<span t-esc="result['totales']['num_documentos']"/> documentos)</strong></td>
                                <td class="text-right text-end"><strong><span t-esc="result['totales']['base']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong></td>
                                <td class="text-right text-end"><strong><span t-esc="result['totales']['isr']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong></td>
                                <td class="text-right text-end"><strong><span t-esc="result['totales']['total']" t-options="{'widget': 'monetary', 'display_currency': current_company_id.currency_id}"/></strong></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
